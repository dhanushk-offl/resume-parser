{
  "name": "resume-parser-ats",
  "version": "1.2.3",
  "description": "An agent skill that deeply parses resumes, extracts structured data, and provides actionable insights to improve ATS compatibility and readability.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "resume-parser-ats": "bin/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "ts-node src/index.ts",
    "mcp": "ts-node mcp-server/server.ts",
    "lint": "eslint src/",
    "test": "node --test test/evals/parse-resume.test.mjs test/evals/analyze-resume.test.mjs test/evals/suggest-improvements.test.mjs"
  },
  "files": [
    "dist/",
    "bin/",
    "resume-parser-ats/",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "keywords": [
    "resume",
    "parser",
    "ATS",
    "agent-skill",
    "resume-parser",
    "career",
    "skills",
    "npx-skills"
  ],
  "author": "dhanush",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhanushk-offl/resume-parser.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.0.379",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.59.4"
  }
}
